{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "node",
    "outDir": "./api/dist",
    "rootDir": "./api",
    "declaration": false,
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "types": ["node", "express"]
  },
  "include": [
    "api/**/*"
  ],
  "exclude": [
    "api/dist",
    "node_modules",
    "src"
  ]
}